# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/task_management_system

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Email (Nodemailer) - example uses Gmail SMTP with an App Password
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Task Management System <your_email@gmail.com>"

# Frontend URL (used in emails / CORS)
CLIENT_URL=http://localhost:5173

# Default admin created by the seed script
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@xploreintellects.com
ADMIN_PASSWORD=Admin@12345
